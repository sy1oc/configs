# Generated by cvt <Width> <Height> <Rate>
xrandr --newmode "1280x960"  101.25  1280 1360 1488 1696  960 963 967 996 -hsync +vsync
xrandr --newmode "1440x1080"  129.00  1440 1528 1680 1920  1080 1083 1087 1120 -hsync +vsync
xrandr --newmode "1280x720"  74.50  1280 1344 1472 1664  720 723 728 748 -hsync +vsync
xrandr --newmode "1600x900"  118.25  1600 1688 1856 2112  900 903 908 934 -hsync +vsync
xrandr --newmode "1600x1200"  161.00  1600 1712 1880 2160  1200 1203 1207 1245 -hsync +vsync
xrandr --addmode eDP1 1280x960
xrandr --addmode eDP1 1440x1080
xrandr --addmode eDP1 1280x720
xrandr --addmode eDP1 1600x900
xrandr --addmode eDP1 1600x1200 
# 4:3 resolution
#xrandr --output eDP1 --mode 1280x960 --set "scaling mode" "Full"
#xrandr --output eDP1 --mode 1440x1080 --set "scaling mode" "Full"
xrandr --output eDP1 --mode 1600x1200 --set "scaling mode" "Full"
# 16:9 resolution
#xrandr --output eDP1 --mode 1280x720 --set "scaling mode" "Full"
#xrandr --output eDP1 --mode 1600x900 --set "scaling mode" "Full"

# "xset r 66" for caps behaviour
setxkbmap us -v colemak && xset r 66
xinput --set-prop 11 327 0
xinput --set-prop 11 330 0 1 0
xbacklight -set 50

while xsetroot -name " `timedatectl | awk 'NR == 1 {
    print $4, $3, $5
}'` | `cat /sys/class/power_supply/BAT0/capacity`% "
do
    sleep1
done &


cd ~
picom &
feh --bg-max --randomize ~/.wallpapers/* &
exec dwm
