{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "spacing": 10,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "network", "battery"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "1B",
            "2": "2C",
            "3": "3D",
            "4": "4E",
            "5": "5F",
            "6": "6G",
            "7": "7H",
            "8": "8I",
            "9": "9J",
            "10": "0K",
            "active": "●",
            "default": "○"
        },
        "persistent-workspaces": { "*": 10 }
    },
    "clock": {
        "interval": 1,
        "format": " {:%H:%M:%S   %y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  Wired Connected",
        "format-disconnected": "󰤮  Disconnected",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "Network: {essid}\nSignalStrength: {signalStrength}%\nIP: {ipaddr}"
    },
    "battery": {
        "states": {"warning": 30, "critical": 15},
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
